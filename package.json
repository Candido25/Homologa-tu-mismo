{
  "name": "homologa-tu-mismo",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "local:up": "docker compose up -d --wait",
    "local:status": "docker compose ps",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v && docker compose up -d --wait && npm run db:migrate && npm run db:seed",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "db:migrate:portable": "node scripts/migrate-postgres.mjs",
    "db:seed": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U homologa -d homologa -f /database/seeds/0001_reference_data.sql && docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U homologa -d homologa -f /database/seeds/9000_local_test_fixtures.sql",
    "db:verify": "docker compose exec -T postgres psql -U homologa -d homologa -c \"select version, applied_at from schema_migrations order by applied_at;\"",
    "app:verify-local": "node scripts/verify-local-web-flow.mjs",
    "documents:verify-local": "node scripts/verify-local-document-flow.mjs",
    "retention:verify-local": "node scripts/verify-local-retention.mjs",
    "azure:verify-recovery": "node scripts/verify-azure-document-recovery.mjs",
    "security:verify-local": "node scripts/verify-local-isolation.mjs",
    "storage:verify": "node scripts/verify-azurite.mjs",
    "test": "jest"
  },
  "dependencies": {
    "@azure/identity": "4.13.0",
    "@azure/msal-node": "5.4.3",
    "@azure/storage-blob": "12.33.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.9",
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "jest": "^30.4.2",
    "postcss": "^8.5.25",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
