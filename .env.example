# Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local
DOCUMENT_RETENTION_DAYS=30
DOCUMENT_UPLOAD_UI_ENABLED=true
# Solo para desarrollo local. Usar un secreto independiente en cada entorno administrado.
DOCUMENT_RETENTION_JOB_TOKEN=local-retention-job-test-only

# Proveedores seleccionados por entorno
AUTH_PROVIDER=local-test
DATABASE_PROVIDER=postgres
STORAGE_PROVIDER=azurite

# PostgreSQL local
DATABASE_URL=postgresql://homologa:homologa_local_only@localhost:5432/homologa

# Azurite local. UseDevelopmentStorage=true solo debe usarse fuera de producción.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CASE_DOCUMENTS_CONTAINER=case-documents
AZURE_STORAGE_GENERATED_REPORTS_CONTAINER=generated-reports

# Usuario ficticio para el adaptador local de autenticación
LOCAL_TEST_USER_ID=00000000-0000-4000-8000-000000000001

# Microsoft Entra External ID. Configuración exclusivamente del servidor.
ENTRA_TENANT_ID=
ENTRA_TENANT_SUBDOMAIN=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_SESSION_HOURS=12

# Supabase - Plataforma principal de Base de datos, Autenticación y Storage
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Polar.sh Monetización
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_PREMIUM_PRODUCT_PRICE_ID=your-polar-price-id
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# Inteligencia artificial: desactivada hasta configurar proveedor y controles
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=

# Procesamiento asíncrono futuro
QUEUE_URL=
